      "no": 1,
      "order": 1,
      "head": "第1场 外景 · 便利店门口 · 夜",
      "intExt": "外景",
      "location": "便利店门口",
      "time": "夜",
      "characters": [
        "林晚"
      ],
      "lines": [
        {
          "speaker": "林晚",
          "stage": "",
          "text": "又是一整夜的雨。"
        }
      ],
      "actions": [
        "雨下得很急，霓虹招牌在水洼里碎成一片。",
        "林晚（27岁，便利店店员）把伞架搬到门边，抬头看了眼街对面。",
        "一辆黑色轿车停在路边，没有熄火。",
        "她低头看了眼手机，屏幕上是三条未读消息。"
      ]
    },
    {
      "no": 2,
      "order": 2,
      "head": "第2场 内景 · 便利店收银台 · 连续",
      "intExt": "内景",
      "location": "便利店收银台",
      "time": "连续",
      "characters": [
        "陈默",
        "林晚"
      ],
      "lines": [
        {
          "speaker": "陈默",
          "stage": "",
          "text": "还有热的吗？"
        },
        {
          "speaker": "林晚",
          "stage": "",
          "text": "只剩这一罐了。"
        },
        {
          "speaker": "林晚",
          "stage": "把咖啡推回去",
          "text": "你不是第一次来这儿。"
        },
        {
          "speaker": "陈默",
          "stage": "",
          "text": "……我以前住这附近。"
        }
      ],
      "actions": [
        "自动门叮咚响。",
        "陈默（30岁，外套湿透）走进来，把一罐热咖啡放在柜台上。",
        "陈默的手在发抖，他没有抬头。"
      ]
    },
    {
      "no": 3,
      "order": 3,
      "head": "第3场 内景 · 便利店靠窗座位 · 稍后",
      "intExt": "内景",
      "location": "便利店靠窗座位",
      "time": "稍后",
      "characters": [
        "林晚",
        "陈默"
      ],
      "lines": [
        {
          "speaker": "林晚",
          "stage": "",
          "text": "你一直在等谁？"
        },
        {
          "speaker": "陈默",
          "stage": "",
          "text": "等我女儿。她以前每天这个点来买酸奶。"
        }
      ],
      "actions": [
        "两人隔着一张小桌坐下，雨声被玻璃挡在外面。",
        "陈默从口袋里拿出一张旧照片，推到桌子中间。",
        "林晚没有说话，把那罐热咖啡轻轻推到照片旁边。",
        "镜头缓缓拉远，便利店的暖光在雨夜里像一小块岛。"
      ]
    },
    {
      "no": 4,
      "order": 4,
      "head": "第4场 外景 · 便利店门口 · 次日清晨",
      "intExt": "外景",
      "location": "便利店门口",
      "time": "次日清晨",
      "characters": [
        "林晚"
      ],
      "lines": [
        {
          "speaker": "林晚",
          "stage": "轻声",
          "text": "明天见。"
        }
      ],
      "actions": [
        "雨停了。林晚把伞架收回店里，街对面的车位空着。",
        "柜台上留着那张旧照片，背面写着一行字：谢谢你还记得。"
      ]
    }
